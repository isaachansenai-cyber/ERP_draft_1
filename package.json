{
  "name": "meats-around-the-world-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit",
    "test:db": "node scripts/db/local-reset.mjs && supabase test db",
    "test:integration": "vitest run --project integration-pilot && vitest run --project integration-ops && vitest run --project integration-demo",
    "test:secrets": "node scripts/security/scan-secrets.mjs",
    "test:e2e": "playwright test --trace off",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "node scripts/db/local-reset.mjs",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript > src/lib/database.types.ts",
    "import:source": "tsx scripts/import/import-source-master.ts",
    "import:demo": "tsx scripts/import/import-demo-seed.ts && tsx scripts/import/import-demo-history.ts",
    "demo:users": "tsx scripts/demo/create-demo-users.ts",
    "demo:reset": "tsx scripts/demo/reset-demo.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "decimal.js": "^10.6.0",
    "jsbarcode": "^3.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}

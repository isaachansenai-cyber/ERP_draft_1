# Frontend (public by design). Only the project URL and the publishable/anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>
# Repository base path for GitHub Pages, e.g. /ERP_draft_1/ ; "/" for local dev.
VITE_BASE_PATH=/
# Display-only hint shown before sign-in if the server cannot be reached. The
# real data-mode banner always comes from the database (app_settings.data_mode).
VITE_DATA_MODE_HINT=

# ---------------------------------------------------------------------------
# Operator tooling ONLY (scripts/). Put real values in a gitignored .env.local,
# never in this file, never in the frontend, never in the repository.
# ---------------------------------------------------------------------------
# Direct Postgres connection for imports (add ?sslmode=require for hosted).
DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:54322/postgres
# Same project's API URL (must match DATABASE_URL's project).
SUPABASE_URL=http://127.0.0.1:54321
# Needed only by scripts/demo/create-demo-users.ts against a DEMO project.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated demo project refs that demo tooling may touch ("local" = local stack).
DEMO_PROJECT_REF_ALLOWLIST=
